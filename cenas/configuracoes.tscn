[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/configuracoes.gd" id="1_r"]
[ext_resource type="Theme" path="res://assets/tema.tres" id="2_r"]
[ext_resource type="Texture2D" path="res://assets/fundo_menu.png" id="3_r"]
[ext_resource type="AudioStream" path="res://musicas/menu.ogg" id="4_r"]
[ext_resource type="AudioStream" path="res://sons/clique.wav" id="5_r"]
[ext_resource type="AudioStream" path="res://sons/figurinha.wav" id="6_r"]

[node name="Configuracoes" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_r")
script = ExtResource("1_r")

[node name="Fundo" type="TextureRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
texture = ExtResource("3_r")
expand_mode = 1
stretch_mode = 6

[node name="Escurecer" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0, 0, 0, 0.7)

[node name="Musica" type="AudioStreamPlayer" parent="."]
stream = ExtResource("4_r")
bus = &"Musica"
autoplay = true

[node name="SomClique" type="AudioStreamPlayer" parent="."]
stream = ExtResource("5_r")
bus = &"Efeitos"

[node name="Titulo" type="Label" parent="."]
layout_mode = 1
anchors_preset = 10
anchor_right = 1.0
offset_top = 40.0
offset_bottom = 130.0
grow_horizontal = 2
theme_override_colors/font_color = Color(1, 0.85, 0.1, 1)
theme_override_constants/outline_size = 14
theme_override_font_sizes/font_size = 60
text = "CONFIGURAÇÕES"
horizontal_alignment = 1

[node name="Opcoes" type="GridContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -330.0
offset_top = -120.0
offset_right = 330.0
offset_bottom = 100.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/h_separation = 40
theme_override_constants/v_separation = 36
columns = 2

[node name="RotuloSliderMusica" type="Label" parent="Opcoes"]
layout_mode = 2
text = "Música"

[node name="SliderMusica" type="HSlider" parent="Opcoes"]
custom_minimum_size = Vector2(380, 30)
layout_mode = 2
size_flags_vertical = 4
max_value = 1.0
step = 0.05
value = 1.0

[node name="RotuloSliderEfeitos" type="Label" parent="Opcoes"]
layout_mode = 2
text = "Efeitos"

[node name="SliderEfeitos" type="HSlider" parent="Opcoes"]
custom_minimum_size = Vector2(380, 30)
layout_mode = 2
size_flags_vertical = 4
max_value = 1.0
step = 0.05
value = 1.0

[node name="RotuloTela" type="Label" parent="Opcoes"]
layout_mode = 2
text = "Tela"

[node name="BotaoTelaCheia" type="Button" parent="Opcoes"]
layout_mode = 2
toggle_mode = true
text = "Tela cheia: NÃO"

[node name="BotaoVoltar" type="Button" parent="."]
layout_mode = 1
anchors_preset = 7
anchor_left = 0.5
anchor_top = 1.0
anchor_right = 0.5
anchor_bottom = 1.0
offset_left = -140.0
offset_top = -120.0
offset_right = 140.0
offset_bottom = -60.0
grow_horizontal = 2
grow_vertical = 0
text = "Voltar"

[node name="SomTeste" type="AudioStreamPlayer" parent="."]
stream = ExtResource("6_r")
bus = &"Efeitos"

[connection signal="finished" from="Musica" to="Musica" method="play"]
[connection signal="value_changed" from="Opcoes/SliderMusica" to="." method="_on_slider_musica_value_changed"]
[connection signal="value_changed" from="Opcoes/SliderEfeitos" to="." method="_on_slider_efeitos_value_changed"]
[connection signal="toggled" from="Opcoes/BotaoTelaCheia" to="." method="_on_botao_tela_cheia_toggled"]
[connection signal="pressed" from="Opcoes/BotaoTelaCheia" to="SomClique" method="play"]
[connection signal="pressed" from="BotaoVoltar" to="." method="_on_botao_voltar_pressed"]
[connection signal="pressed" from="BotaoVoltar" to="SomClique" method="play"]
