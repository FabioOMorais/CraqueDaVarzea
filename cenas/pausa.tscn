[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/pausa.gd" id="1_r"]
[ext_resource type="Theme" path="res://assets/tema.tres" id="2_r"]

[node name="Pausa" type="CanvasLayer"]
process_mode = 3
layer = 10
